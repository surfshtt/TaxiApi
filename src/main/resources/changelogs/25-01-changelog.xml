<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1779705838929-1" author="fk8ght">
        <createTable tableName="passengers">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_passengers"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN"/>
        </createTable>
    </changeSet>
    <changeSet id="1779705838929-2" author="fk8ght">
        <addUniqueConstraint columnNames="email" constraintName="uc_passengers_email" tableName="passengers"/>
    </changeSet>
    <changeSet id="1779705838929-3" author="fk8ght">
        <addUniqueConstraint columnNames="phone" constraintName="uc_passengers_phone" tableName="passengers"/>
    </changeSet>

    <changeSet id="1779705838929-4" author="fk8ght">
        <createTable tableName="drivers">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_drivers"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>
    <changeSet id="1779705838929-5" author="fk8ght">
        <addUniqueConstraint columnNames="email" constraintName="uc_drivers_email" tableName="drivers"/>
    </changeSet>
    <changeSet id="1779705838929-6" author="fk8ght">
        <addUniqueConstraint columnNames="phone" constraintName="uc_drivers_phone" tableName="drivers"/>
    </changeSet>

    <changeSet id="1779705838929-7" author="fk8ght">
        <createTable tableName="cars">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cars"/>
            </column>
            <column name="color" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="brand" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="plate_number" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="driver_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>
    <changeSet id="1779705838929-8" author="fk8ght">
        <addUniqueConstraint columnNames="plate_number" constraintName="uc_cars_plate_number" tableName="cars"/>
    </changeSet>
    <changeSet id="1779705838929-9" author="fk8ght">
        <addForeignKeyConstraint baseColumnNames="driver_id" baseTableName="cars"
                                 constraintName="fk_cars_driver" referencedColumnNames="id"
                                 referencedTableName="drivers"/>
    </changeSet>

    <changeSet id="1779705838929-10" author="fk8ght">
        <createTable tableName="trips">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_trips"/>
            </column>
            <column name="driver_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="passenger_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="pickup_address" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="destination_address" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="ordered_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="cost" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1779705838929-11" author="fk8ght">
        <addForeignKeyConstraint baseColumnNames="driver_id" baseTableName="trips"
                                 constraintName="fk_trips_driver" referencedColumnNames="id"
                                 referencedTableName="drivers"/>
    </changeSet>
    <changeSet id="1779705838929-12" author="fk8ght">
        <addForeignKeyConstraint baseColumnNames="passenger_id" baseTableName="trips"
                                 constraintName="fk_trips_passenger" referencedColumnNames="id"
                                 referencedTableName="passengers"/>
    </changeSet>

    <changeSet id="1779705838929-13" author="fk8ght">
        <createTable tableName="ratings">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ratings"/>
            </column>
            <column name="trip_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="driver_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="passenger_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rated_by" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="score" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(1024)"/>
        </createTable>
    </changeSet>
    <changeSet id="1779705838929-14" author="fk8ght">
        <addForeignKeyConstraint baseColumnNames="trip_id" baseTableName="ratings"
                                 constraintName="fk_ratings_trip" referencedColumnNames="id"
                                 referencedTableName="trips"/>
    </changeSet>
    <changeSet id="1779705838929-15" author="fk8ght">
        <addUniqueConstraint columnNames="trip_id, rated_by" constraintName="uc_ratings_trip_rated_by" tableName="ratings"/>
    </changeSet>

    <changeSet id="1779705838929-16" author="fk8ght">
        <insert tableName="passengers">
